# --- Server ---
PORT=5000
NODE_ENV=development

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Frontend (used to build the password-reset link) ---
FRONTEND_URL=http://localhost:5173

# --- Email (Nodemailer SMTP) ---
# If these are NOT set, /auth/forgot-password still works:
# the reset link is logged to the server console and (in development)
# returned in the JSON response so you can test the flow without SMTP.
#
# Example (Gmail App Password):
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USER=youraddress@gmail.com
#   EMAIL_PASS=your-16-char-app-password
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
